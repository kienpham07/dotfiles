{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/kienpham07/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────Hardware─────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢  PC",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└ └󰋊 ",
      "keyColor": "green",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────Software─────────────┐"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "yellow",
      "format": "{2} {12}"
    },
    {
      "type": "packages",
      "key": "│ ├󰏗 ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "└ └󰞷 ",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────DE────────────────┐"
    },
    {
      "type": "de",
      "key": "󰧨  DE",
      "keyColor": "blue"
    },
    {
      "type": "lm",
      "key": "│ ├󰍁 ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├󱂬 ",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉦 ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "└ └󰆍 ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────Uptime / Age───────────┐"
    },
    {
      "type": "command",
      "key": "  ›  OS Age  ",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  ›  Uptime  ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
